# Copie para .env (NUNCA suba o .env pro GitHub). No GitHub Actions, cadastre como Secrets.

# ---------- Instagram (API do Instagram com login do Instagram) ----------
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://github.com/
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0

# ---------- TikTok (Content Posting API) ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://github.com/
TIKTOK_REFRESH_TOKEN=
# SELF_ONLY enquanto o app nao for auditado pelo TikTok; depois PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# true = marca o video como "promovendo meu proprio negocio"
TIKTOK_BRAND_ORGANIC=false

# ---------- Geral ----------
# URL publica onde ficam as IMAGENS da pasta media/ (o Instagram baixa por URL)
MEDIA_BASE_URL=
TIMEZONE=America/Sao_Paulo
# Quantas horas de atraso ainda vale postar um item que passou do horario
JANELA_ATRASO_HORAS=12
DRY_RUN=false
